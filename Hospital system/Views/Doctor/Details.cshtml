@model Hospital_system.Models.Doctor

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2>Doctor Details: @Model.DoctorID</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="~/images/@Model.Image" alt="@Model.Name" class="img-fluid rounded" style="max-height: 250px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="p-4 bg-light border rounded">No Image Available</div>
                    }
                </div>
                <div class="col-md-8">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 30%;">ID</th>
                            <td>@Model.DoctorID</td>
                        </tr>
                        <tr>
                            <th>Name</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>Age</th>
                            <td>@Model.Age</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.Email</td>
                        </tr>
                        <tr>
                            <th>Phone</th>
                            <td>@Model.Phone</td>
                        </tr>
                        <tr>
                            <th>Salary</th>
                            <td>@Model.Salary</td>
                        </tr>
                        <tr>
                            <th>Department</th>
                            <td>@Model.Department?.DepartmentName</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>